{
  "name": "walkersutton.github.io",
  "homepage": "https://walkersutton.github.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenvx run --quiet --overload -- next dev --turbopack",
    "img": "dotenvx run --quiet --overload -- node scripts/img.mts",
    "export:report": "dotenvx run --quiet --overload -- node scripts/export-report.mts",
    "migrate:imgur": "dotenvx run --quiet --overload -- node scripts/migrate-imgur.mts",
    "build": "dotenvx run --quiet --overload -- next build",
    "start": "npx serve out",
    "lint": "eslint app/ lib/",
    "typecheck": "tsc --noEmit",
    "deploy": "gh-pages -d out --nojekyll",
    "prepare": "husky"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.17.2",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "@types/leaflet": "^1.9.21",
    "@vercel/blob": "^2.5.0",
    "gh-pages": "^6.3.0",
    "gray-matter": "^4.0.3",
    "leaflet": "^1.9.4",
    "marked": "^17.0.4",
    "next": "16.2.6",
    "next-mdx-remote": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "resend": "^6.12.4",
    "stripe": "^20.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.3.3",
    "husky": "^9.1.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
